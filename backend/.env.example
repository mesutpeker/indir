# Zorunlu: Frontend'den baglanirken kullanacaginiz gizli API anahtari
# Ornek uretim: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=buraya-guclu-bir-sifre-yazin

# CORS izni verilen frontend adresleri (virgul ile ayrilmis)
ALLOWED_ORIGINS=https://mesutpeker.com,https://indir.mesutpeker.com,https://mesutpeker.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Gecici indirme klasoru ve otomatik silme suresi (saniye, varsayilan 900 = 15 dk)
DOWNLOAD_DIR=./downloads
FILE_TTL_SECONDS=900

# Eszamanli indirme limiti ve maksimum dosya boyutu (MB, 0 = sinirsiz)
MAX_CONCURRENT_JOBS=2
MAX_FILESIZE_MB=1024

# Opsiyonel: Giris gerektiren Instagram/Facebook/YouTube videolari icin
# Mac yerel kullanimda ornek: COOKIES_FROM_BROWSER=chrome (veya safari, firefox)
# Sunucu/Docker kullanimda ornek: COOKIES_FILE=./cookies.txt
COOKIES_FROM_BROWSER=
COOKIES_FILE=

# Opsiyonel: Bulut/VPS ortaminda YouTube PO Token yan servisi (docker-compose pot-provider profili)
# PO_TOKEN_BASE_URL=http://pot-provider:4416

# Varsayilan olarak yalnizca YouTube, X/Twitter, Instagram ve Facebook URL'leri kabul edilir.
# yt-dlp'nin destekledigi tum sitelere acmak isterseniz true yapin.
ALLOW_ALL_DOMAINS=false

HOST=127.0.0.1
PORT=8000
